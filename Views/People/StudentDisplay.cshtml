@model IEnumerable<NtandoMabuthoStudyGroupP2.Models.Student>

@{
    ViewBag.Title = "Student List";
}

<h2>Student List</h2>

<!-- Link to Add Student -->
<div>
    @Html.ActionLink("Create New", "Create", null, new { @class = "button" })
</div>

<br />

<!-- Search Box -->
<div class="form-inline mb-3">
    <input type="text" id="searchBox" class="form-control" placeholder="Search by First Name" style="width: 300px;" />
    <button type="button" id="searchBtn" class="btn btn-primary">Search</button>
</div>

<!-- Student Table -->
<table class="table table-bordered" id="studentTable">
    <thead>
        <tr>
            <th>Student Number</th>
            <th>First Name</th>
            <th>Surname</th>
            <th>Email</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody id="studentTableBody">
        @foreach (var student in Model)
        {
            <tr data-student-number="@student.StudentNumber">
                <td>@student.StudentNumber</td>
                <td class="first-name">@student.FirstNaam</td>
                <td>@student.Surname</td>
                <td>@student.Email</td>
                <td>
                    <button class="btn btn-danger delete-btn">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>
<script>

    // Handle delete button clicks
    document.addEventListener("DOMContentLoaded", function () {
        const tableBody = document.getElementById("studentTableBody");

        tableBody.addEventListener("click", function (e) {
            if (e.target && e.target.classList.contains("delete-btn")) {
                const row = e.target.closest("tr");
                if (row) {
                    row.remove();
                }
            }
        });
    });
</script>

<!-- Storage Buttons -->
<div class="mb-3">
    <button type="button" class="button" onclick="saveToLocal()">Save to Local Storage</button>
    <button type="button" class="button" onclick="loadFromLocal()">Load from Local Storage</button>
    <button type="button" class="button" onclick="clearLocal()">Clear Local Storage</button>
</div>

<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $(document).ready(function () {
        // Search Function
        $('#searchBtn').click(function () {
            const searchTerm = $('#searchBox').val().toLowerCase();
            $('#studentTableBody tr').each(function () {
                const row = $(this);
                const firstName = row.find('.first-name').text().toLowerCase();

                row.css('color', '');

                if (searchTerm && firstName.includes(searchTerm)) {
                    row.css('color', 'red');
                    setTimeout(() => row.css('color', ''), 3000);
                }
            });
        });
    });

    // Save to Local Storage
    function saveToLocal() {
        let data = '';
        $('#studentTableBody tr').each(function () {
            let row = $(this);
            let rowData = row.find('td').map(function () {
                return $(this).text().trim();
            }).get().slice(0, 4).join('|'); // Only get the 4 student fields (ignore Delete btn)
            data += rowData + '\n';
        });

        localStorage.setItem('studentData', data.trim());
        alert("Student list saved to local storage.");
    }

    // Load from Local Storage
    function loadFromLocal() {
        const data = localStorage.getItem('studentData');
        if (!data) {
            alert("No data found in local storage.");
            return;
        }

        const rows = data.split('\n');
        let newBody = '';
        rows.forEach(row => {
            const cells = row.split('|');
            newBody += '<tr>';
            newBody += `<td>${cells[0]}</td>`;
            newBody += `<td class="first-name">${cells[1]}</td>`;
            newBody += `<td>${cells[2]}</td>`;
            newBody += `<td>${cells[3]}</td>`;
            newBody += `<td><button class="btn btn-danger delete-btn">Delete</button></td>`;
            newBody += '</tr>';
        });

        $('#studentTableBody').html(newBody);
    }

    // Clear Local Storage
    function clearLocal() {
        localStorage.removeItem('studentData');
        alert("Local storage cleared.");
    }

</script>

